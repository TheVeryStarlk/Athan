<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Athan.Desktop.Features.Prayers"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewExtenders="clr-namespace:Athan.Desktop.ViewExtenders"

             x:Class="Athan.Desktop.Features.Prayers.PrayersView"

             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:PrayersViewModel, IsDesignTimeCreatable=False}">

    <Grid>
        <ui:TextBlock x:Name="WaitTextBlock" Text="Please wait..." HorizontalAlignment="Center" />

        <StackPanel x:Name="MainStackPanel" Visibility="Collapsed" viewExtenders:SpacingSetter.Spacing="25">
            <StackPanel.Resources>
                <Style TargetType="ui:TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </StackPanel.Resources>

            <ui:Card Padding="75 25 75 25" HorizontalAlignment="Center">
                <StackPanel>
                    <ui:TextBlock Text="Next prayer" Opacity="0.75" />
                    <ui:TextBlock Text="{Binding NextPrayer.Name, FallbackValue=''}" HorizontalAlignment="Center" FontSize="25" />
                </StackPanel>
            </ui:Card>

            <ui:CardExpander Header="Prayers">
                <StackPanel viewExtenders:SpacingSetter.Spacing="10">
                    <ui:ListView x:Name="PrayersListView" ItemsSource="{Binding Prayers}" SelectedItem="{Binding NextPrayer, Mode=OneWay}"
                                 SelectionChanged="PrayersSelectionChanged">

                        <ui:ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:Prayer}">
                                <Grid Margin="10">
                                    <ui:TextBlock Text="{Binding Name}" HorizontalAlignment="Left" />
                                    <ui:TextBlock Text="{Binding ReadableTime}" Opacity="0.75" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </Grid>
</UserControl>