<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Athan.Desktop.Features.Offline"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:features="clr-namespace:Athan.Desktop.Features"

             x:Class="Athan.Desktop.Features.Offline.OfflineView"

             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:OfflineViewModel, IsDesignTimeCreatable=False}">

    <StackPanel>
        <ui:TextBlock Text="You are offline" FontTypography="Title" />
        <ui:TextBlock Text="You will be redirected automatically once you reconnect to the internet." />
    </StackPanel>
</UserControl>