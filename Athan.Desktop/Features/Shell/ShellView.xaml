<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:Athan.Desktop.Features.Shell"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewExtenders="clr-namespace:Athan.Desktop.ViewExtenders"
                 xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"

                 x:Class="Athan.Desktop.Features.Shell.ShellView"

                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=local:ShellViewModel, IsDesignTimeCreatable=False}"

                 Title="Athan" Width="625" Height="750" MinWidth="425" MinHeight="550"
                 ExtendsContentIntoTitleBar="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowBackdropType="Mica" WindowCornerPreference="Round" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Height="60" ShowMaximize="False" Grid.Row="0" />

        <tray:NotifyIcon FocusOnLeftClick="True" TooltipText="Athan" Grid.Row="0" />

        <StackPanel viewExtenders:SpacingSetter.Spacing="15" Orientation="Horizontal"
                    Margin="22.5 20 0 0" VerticalAlignment="Top" Grid.Row="0">

            <Image Source="../../Athan.ico" Width="20" Height="20" />
            <TextBlock Text="Athan" />
        </StackPanel>

        <Grid x:Name="MainGrid" Visibility="Collapsed" Grid.Row="1">
            <ui:Card Margin="40 0 40 40" Padding="40">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl x:Name="Shell" Grid.Row="0" />

                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding NavigateSettingsCommand}"
                               ToolTip="Settings" Margin="0 20 0 0" Grid.Row="1">

                        <ui:SymbolIcon Symbol="Settings48" FontSize="15" />
                    </ui:Button>
                </Grid>
            </ui:Card>
        </Grid>

        <ContentControl x:Name="SettingsShell" Margin="40 0 40 40" VerticalAlignment="Center"
                        Visibility="Collapsed" Grid.Row="1" />

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" />
    </Grid>
</ui:FluentWindow>