<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Athan.ico</ApplicationIcon>
		<Company>Starlk</Company>
		<Product>Athan</Product>
		<NeutralLanguage>en</NeutralLanguage>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
		<PackageReference Include="DesktopNotifications.Windows" Version="1.3.1"/>
		<PackageReference Include="FluentResults" Version="3.16.0"/>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0"/>
		<PackageReference Include="WPF-UI" Version="3.0.5"/>
		<PackageReference Include="WPF-UI.Tray" Version="3.0.5"/>
	</ItemGroup>

	<ItemGroup>
		<None Remove="Athan.ico"/>
		<Resource Include="Athan.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>

</Project>