<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tasbih="using:Siraj.Features.Tasbih"
      x:Class="Siraj.Features.Tasbih.TasbihView"
      d:DataContext="{d:DesignInstance Type=tasbih:TasbihViewModel}"
      mc:Ignorable="d">

    <Grid RowSpacing="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <controls:RadialGauge Width="280"
                                  IsEnabled="True"
                                  IsInteractive="False"
                                  MaxAngle="145"
                                  Maximum="100"
                                  MinAngle="-145"
                                  Minimum="0"
                                  NeedleWidth="0"
                                  ScaleWidth="10"
                                  TickLength="0"
                                  Value="{x:Bind ViewModel.Value, Mode=OneWay}" />

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="4">

                <Button Width="48"
                        Height="48"
                        Command="{x:Bind ViewModel.AddCommand}"
                        Style="{StaticResource AccentButtonStyle}">

                    <SymbolIcon Symbol="Add" />
                </Button>

                <Button Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ResetCommand}"
                        Style="{StaticResource SubtleButtonStyle}">

                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource BorderStyle}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Width="36"
                        Height="36"
                        Margin="16"
                        Padding="0"
                        Command="{x:Bind ViewModel.LeftCommand}">

                    <FontIcon FontFamily="Segoe MDL2 Assets"
                              FontSize="16"
                              Glyph="&#xE76B;" />
                </Button>

                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Text="{x:Bind ViewModel.Current, Mode=OneWay}"
                           TextAlignment="Center" />

                <Button Grid.Column="2"
                        Width="36"
                        Height="36"
                        Margin="16"
                        Padding="0"
                        Command="{x:Bind ViewModel.RightCommand}">

                    <FontIcon FontFamily="Segoe MDL2 Assets"
                              FontSize="16"
                              Glyph="&#xE76C;" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>