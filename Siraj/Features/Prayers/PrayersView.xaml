<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:prayers="using:Siraj.Features.Prayers"
      x:Class="Siraj.Features.Prayers.PrayersView"
      d:DataContext="{d:DesignInstance Type=prayers:PrayersViewModel}"
      mc:Ignorable="d">

    <Page.Resources>
        <prayers:UpcomingToRowConverter x:Key="UpcomingToRowConverter" />
    </Page.Resources>

    <ScrollView>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0 0 0 24">

                <StackPanel HorizontalAlignment="Left"
                            Spacing="4">

                    <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                               Text="{x:Bind ViewModel.Title}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />

                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.Description, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  ColumnSpacing="12"
                  RowSpacing="12">

                <Grid.Resources>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

                        <Setter Property="BorderBrush"
                                Value="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <Setter Property="BorderThickness"
                                Value="1" />

                        <Setter Property="CornerRadius"
                                Value="{ThemeResource ControlCornerRadius}" />

                        <Setter Property="Padding"
                                Value="20 16 20 16" />
                    </Style>
                </Grid.Resources>

                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0">
                    <Grid Padding="24 0 24 0">
                        <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Spacing="4">

                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource SystemFillColorAttentionBrush}"
                                       Style="{StaticResource TitleTextBlockStyle}"
                                       Text="{x:Bind ViewModel.Upcoming, Mode=OneWay}" />

                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.Remaining, Mode=OneWay}" />
                        </StackPanel>

                        <ToggleButton Width="36"
                                      Height="36"
                                      Padding="0"
                                      HorizontalAlignment="Right"
                                      IsChecked="{x:Bind ViewModel.IsDefault, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Receive notifications for this location">

                            <FontIcon FontSize="16"
                                      Glyph="&#xEA8F;" />
                        </ToggleButton>
                    </Grid>
                </Border>

                <Border Grid.Row="1">
                    <Grid Margin="12 0 12 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid.Resources>
                            <DataTemplate x:Key="PrayerTemplate"
                                          x:DataType="prayers:Prayer">

                        <Grid Grid.Row="0"
                              VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource BodyLargeTextBlockStyle}"
                                           Text="🌅" />

                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="{x:Bind ViewModel.Prayers[0].Kind}" />
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.Prayers[0].Time}" />
                        </Grid>

                        <Grid Grid.Row="1"
                              VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource BodyLargeTextBlockStyle}"
                                           Text="🌄" />

                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="{x:Bind ViewModel.Prayers[1].Kind}" />
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.Prayers[1].Time}" />
                        </Grid>

                        <Grid Grid.Row="2"
                              VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource BodyLargeTextBlockStyle}"
                                           Text="🌇" />

                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="{x:Bind ViewModel.Prayers[2].Kind}" />
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.Prayers[2].Time}" />
                        </Grid>

                        <Grid Grid.Row="3"
                              VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource BodyLargeTextBlockStyle}"
                                           Text="🌆" />

                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="{x:Bind ViewModel.Prayers[3].Kind}" />
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.Prayers[3].Time}" />
                        </Grid>

                        <Grid Grid.Row="4"
                              VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource BodyLargeTextBlockStyle}"
                                           Text="🌌" />

                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="{x:Bind ViewModel.Prayers[4].Kind}" />
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.Prayers[0].Time}" />
                        </Grid>

                        <Border Grid.Row="{x:Bind ViewModel.Upcoming, Converter={StaticResource UpcomingToRowConverter}, Mode=OneWay}"
                                Margin="-16 0 -16 0"
                                BorderThickness="0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollView>
</Page>