<Page x:Class="Siraj.Features.Prayers.PrayersView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:prayers="using:Siraj.Features.Prayers"
      d:DataContext="{d:DesignInstance Type=prayers:PrayersViewModel}"
      mc:Ignorable="d">

    <ScrollView>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0 0 0 24">

                <StackPanel HorizontalAlignment="Left"
                            Spacing="4">

                    <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                               Text="{x:Bind ViewModel.Title}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0 0 48 0" />

                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.Description, Mode=OneWay}" />
                </StackPanel>

                <ToggleButton Width="36"
                              Height="36"
                              Padding="0"
                              HorizontalAlignment="Right"
                              IsChecked="{x:Bind ViewModel.IsDefault, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              ToolTipService.ToolTip="Receive notifications for this location">

                    <FontIcon FontSize="16"
                              Glyph="&#xEA8F;" />
                </ToggleButton>
            </Grid>

            <Grid Grid.Row="1"
                  ColumnSpacing="12"
                  RowSpacing="12">

                <Grid.Resources>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

                        <Setter Property="BorderBrush"
                                Value="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <Setter Property="BorderThickness"
                                Value="1" />

                        <Setter Property="CornerRadius"
                                Value="{ThemeResource ControlCornerRadius}" />

                        <Setter Property="Padding"
                                Value="20 16 20 16" />
                    </Style>
                </Grid.Resources>

                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Spacing="4"
                                    Margin="24 0 0 0">

                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource SystemFillColorAttentionBrush}"
                                       Style="{StaticResource TitleTextBlockStyle}"
                                       Text="{x:Bind ViewModel.Upcoming, Mode=OneWay}" />

                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind ViewModel.Remaining, Mode=OneWay}"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.Prayers[0].Time}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0 0 16 0" />
                    </Grid>
                </Border>

                <Border Grid.Row="1">
                    <Grid Margin="12 0 12 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid.Resources>
                            <Style TargetType="StackPanel">
                                <Setter Property="Spacing"
                                        Value="8" />
                            </Style>
                        </Grid.Resources>

                        <Grid VerticalAlignment="Center"
                              Grid.Row="0">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌅"
                                           Style="{StaticResource BodyLargeTextBlockStyle}"
                                           VerticalAlignment="Center" />

                                <TextBlock Text="{x:Bind ViewModel.Prayers[0].Kind}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.Prayers[0].Time}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid VerticalAlignment="Center"
                              Grid.Row="1">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌄"
                                           Style="{StaticResource BodyLargeTextBlockStyle}"
                                           VerticalAlignment="Center" />

                                <TextBlock Text="{x:Bind ViewModel.Prayers[1].Kind}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.Prayers[1].Time}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid VerticalAlignment="Center"
                              Grid.Row="2">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌇"
                                           Style="{StaticResource BodyLargeTextBlockStyle}"
                                           VerticalAlignment="Center" />

                                <TextBlock Text="{x:Bind ViewModel.Prayers[2].Kind}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.Prayers[2].Time}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid VerticalAlignment="Center"
                              Grid.Row="3">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌆"
                                           Style="{StaticResource BodyLargeTextBlockStyle}"
                                           VerticalAlignment="Center" />

                                <TextBlock Text="{x:Bind ViewModel.Prayers[3].Kind}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.Prayers[3].Time}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid VerticalAlignment="Center"
                              Grid.Row="4">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌌"
                                           Style="{StaticResource BodyLargeTextBlockStyle}"
                                           VerticalAlignment="Center" />

                                <TextBlock Text="{x:Bind ViewModel.Prayers[4].Kind}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.Prayers[0].Time}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="0"
                                Margin="-16 0 -16 0"
                                BorderThickness="0">
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollView>
</Page>