<Page x:Class="Siraj.Features.Prayers.PrayersView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:prayers="using:Siraj.Features.Prayers"
      d:DataContext="{d:DesignInstance Type=prayers:PrayersViewModel}"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0 0 0 24">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                       Text="{x:Bind ViewModel.Title}" />

            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.Hijri, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnSpacing="12"
              RowSpacing="12">

            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Background"
                            Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

                    <Setter Property="CornerRadius"
                            Value="{ThemeResource ControlCornerRadius}" />

                    <Setter Property="Padding"
                            Value="20 16 20 16" />
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <Border Grid.Row="0">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">

                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{StaticResource SystemFillColorAttentionBrush}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Text="{x:Bind ViewModel.Upcoming, Mode=OneWay}" />

                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Text="{x:Bind ViewModel.Remaining, Mode=OneWay}"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>