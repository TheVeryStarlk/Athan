<ex:WindowEx x:Class="Siraj.Features.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ex="using:WinUIEx"
             xmlns:items="using:Siraj.Features.Shell.Items"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Title="Siraj"
             Width="900"
             Height="630"
             MinWidth="640"
             MinHeight="500"
             mc:Ignorable="d">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar"
              Grid.Row="0"
              SizeChanged="TitleBarSizeChanged">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="4 0 0 0"
                        Orientation="Horizontal"
                        Spacing="16">

                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <Button x:Name="ToggleButton"
                        Width="36"
                        Height="36"
                        Click="ToggleButtonClick"
                        Style="{ThemeResource TitleBarPaneToggleButtonStyle}"
                        ToolTipService.ToolTip="Navigation" />

                <Image Width="16"
                       Height="16"
                       Source="/Assets/StoreLogo.png" />

                <TextBlock Margin="8 0 0 0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="Siraj" />
            </StackPanel>

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            ItemsSource="{x:Bind viewModel.Suggestions}"
                            PlaceholderText="Search for a city, region, or country"
                            QueryIcon="Find"
                            QuerySubmitted="SearchBoxOnQuerySubmitted"
                            TextChanged="SearchBoxOnTextChanged">

                <AutoSuggestBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F"
                                         Invoked="SearchInvoked"
                                         Modifiers="Control" />
                </AutoSuggestBox.KeyboardAccelerators>
            </AutoSuggestBox>
        </Grid>

        <NavigationView x:Name="NavigationView"
                        Grid.Row="1"
                        Margin="0 -2 0 0"
                        AlwaysShowHeader="True"
                        ExpandedModeThresholdWidth="700"
                        FooterMenuItemsSource="{x:Bind viewModel.Footer}"
                        IsBackButtonVisible="Collapsed"
                        IsPaneOpen="False"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        MenuItemsSource="{x:Bind viewModel.Header}"
                        OpenPaneLength="225"
                        SelectedItem="{x:Bind viewModel.Current, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectionChanged="NavigationViewSelectionChanged">

            <NavigationView.MenuItemTemplateSelector>
                <items:ItemTemplateSelector>
                    <items:ItemTemplateSelector.HeaderTemplate>
                        <DataTemplate x:DataType="items:HeaderViewModel">
                            <NavigationViewItem Content="{x:Bind Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                DataContext="{x:Bind}">

                                <NavigationViewItem.Icon>
                                    <FontIcon FontFamily="Segoe UI Emoji"
                                              Margin="-2"
                                              Glyph="{x:Bind Glyph, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </NavigationViewItem.Icon>

                                <NavigationViewItem.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Command="{x:Bind DeleteCommand}"
                                                        Icon="Delete"
                                                        IsEnabled="{x:Bind Deletable}"
                                                        Text="Delete" />
                                    </MenuFlyout>
                                </NavigationViewItem.ContextFlyout>
                            </NavigationViewItem>
                        </DataTemplate>
                    </items:ItemTemplateSelector.HeaderTemplate>

                    <items:ItemTemplateSelector.FooterTemplate>
                        <DataTemplate x:DataType="items:FooterViewModel">
                            <NavigationViewItem Content="{x:Bind Title}"
                                                DataContext="{x:Bind}">

                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="{x:Bind Glyph}" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </DataTemplate>
                    </items:ItemTemplateSelector.FooterTemplate>
                </items:ItemTemplateSelector>
            </NavigationView.MenuItemTemplateSelector>

            <Frame x:Name="Frame"
                   Padding="36 24 36 36"
                   CornerRadius="{ThemeResource ControlCornerRadius}"
                   Loaded="FrameLoaded" />
        </NavigationView>
    </Grid>
</ex:WindowEx>