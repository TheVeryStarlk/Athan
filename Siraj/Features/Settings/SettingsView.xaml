<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:settings="using:Siraj.Features.Settings"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"

      x:Class="Siraj.Features.Settings.SettingsView"
      d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0 0 0 24" />

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    Spacing="36">

            <StackPanel Spacing="8">
                <TextBlock Text="Appearance and behavior"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Spacing="4">
                    <controls:SettingsCard Header="Application theme"
                                           Description="Change the look of Siraj">

                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </controls:SettingsCard.HeaderIcon>

                        <ComboBox SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Voice"
                                           Description="Change the preferred call to prayer voice">

                        <controls:SettingsCard.HeaderIcon>
                            <SymbolIcon Symbol="Volume" />
                        </controls:SettingsCard.HeaderIcon>

                        <ComboBox SelectedIndex="{x:Bind ViewModel.ReciterIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="Mishary Al-Afasy" />
                            <ComboBoxItem Content="Madinah" />
                            <ComboBoxItem Content="Makkah" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Method"
                                           Description="Change the prayer calculation method">

                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE823;" />
                        </controls:SettingsCard.HeaderIcon>

                        <ComboBox SelectedIndex="{x:Bind ViewModel.CalculationIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="Makkah" />
                            <ComboBoxItem Content="Egypt" />
                            <ComboBoxItem Content="Karachi" />
                            <ComboBoxItem Content="France" />
                            <ComboBoxItem Content="Russia" />
                            <ComboBoxItem Content="Singapore" />
                            <ComboBoxItem Content="Muslim world league" />
                            <ComboBoxItem Content="Islamic society of north America" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Launch at startup"
                                           Description="Automatically launch Siraj when your system starts">

                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEC4A;" />
                        </controls:SettingsCard.HeaderIcon>

                        <ToggleSwitch IsOn="{x:Bind ViewModel.Startup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingsCard>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="About"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                <controls:SettingsExpander Header="Siraj"
                                           Description="An Islamic prayers application"
                                           IsExpanded="True">

                    <controls:SettingsExpander.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False"
                                    UriSource="/Assets/StoreLogo.png" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard HorizontalContentAlignment="Left"
                                               ContentAlignment="Left">

                            <StackPanel Spacing="4"
                                        Margin="0 0 0 8">

                                <HyperlinkButton Content="GitHub repository"
                                                 NavigateUri="https://GitHub.com/TheVeryStarlk/Athan"
                                                 Margin="-12 0 0 0" />

                                <TextBlock Text="Made in Riyadh with ❤️" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>