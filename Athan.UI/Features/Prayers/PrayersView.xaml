<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:prayers="using:Athan.UI.Features.Prayers"

      x:Class="Athan.UI.Features.Prayers.PrayersView"
      d:DataContext="{d:DesignInstance Type=prayers:PrayersViewModel}"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0 0 0 24">

            <TextBlock Text="{x:Bind ViewModel.Title}"
                       Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="{x:Bind ViewModel.Hijri, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid ColumnSpacing="12"
              RowSpacing="12"
              Grid.Row="1">

            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="20 16 20 16" />
                    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <Border Grid.Row="0">
                <Grid>
                    <TextBlock Text="Upcoming"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top" />

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">

                        <TextBlock Text="{x:Bind ViewModel.Upcoming, Mode=OneWay}"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   Foreground="{StaticResource SystemFillColorAttentionBrush}"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                                   TextAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Schedule"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Prayers}"
                                  VerticalAlignment="Center">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="prayers:Prayer">
                                <Grid Margin="0 0 0 2">
                                    <TextBlock Text="{x:Bind Name}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               HorizontalAlignment="Left" />

                                    <TextBlock Text="{x:Bind Time}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
