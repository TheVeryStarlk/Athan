<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Athan.UI.Features.Shell"

        x:Class="Athan.UI.Features.Shell.ShellView"
        mc:Ignorable="d"

        Title="Athan">

    <Grid DataContext="{x:Bind ViewModel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:SplashView x:Name="SplashView" Grid.Row="0" Grid.RowSpan="2">
            <local:SplashView.OpacityTransition>
                <ScalarTransition />
            </local:SplashView.OpacityTransition>
        </local:SplashView>

        <!-- ReSharper disable once Xaml.ConstructorWarning -->
        <ContentControl x:Name="Shell" Opacity="0"
                        Content="{Binding Current, Converter={StaticResource ViewModelConverter}}"
                        Grid.Row="1">

            <ContentControl.ContentTransitions>
                <NavigationThemeTransition />
            </ContentControl.ContentTransitions>

            <ContentControl.OpacityTransition>
                <ScalarTransition />
            </ContentControl.OpacityTransition>
        </ContentControl>

        <TextBlock Text="Athan" Margin="12.5 0 0 0" Grid.Row="0" />
    </Grid>
</Window>