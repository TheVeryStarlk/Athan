<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:empty="using:Athan.UI.Features.Empty"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

      x:Class="Athan.UI.Features.Empty.EmptyView"
      d:DataContext="{d:DesignInstance Type=empty:EmptyViewModel}"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="Get started"
                       Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="You have no saved locations, use your current location or search manually for a location"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            
            <Button Content="Use my location"
                    Command="{x:Bind ViewModel.LocateCommand}"
                    Style="{StaticResource AccentButtonStyle}"/>
        </Grid>
    </Grid>
</Page>