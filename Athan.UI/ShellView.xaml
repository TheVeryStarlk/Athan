<ex:WindowEx xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ex="using:WinUIEx" 
             xmlns:local="using:Athan.UI"

             x:Class="Athan.UI.ShellView"
             mc:Ignorable="d"
             Title="Athan"
             Width="900"
             Height="600"
             MinWidth="640"
             MinHeight="500">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar"
              Grid.Row="0"
              SizeChanged="TitleBarSizeChanged">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.75*" />
                <ColumnDefinition Width="0.75*" />
                <ColumnDefinition Width="0.75*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Spacing="16"
                        Margin="4 0 0 0"
                        Orientation="Horizontal">

                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackButton"
                            ToolTipService.ToolTip="Back"
                            Click="BackButtonClick"
                            Visibility="Collapsed"
                            Width="36"
                            Height="36"
                            Style="{ThemeResource TitleBarBackButtonStyle}" />

                    <Button x:Name="ToggleButton"
                            ToolTipService.ToolTip="Navigation"
                            Click="ToggleButtonClick"
                            Width="36"
                            Height="36"
                            Style="{ThemeResource TitleBarPaneToggleButtonStyle}" />
                </StackPanel>

                <Image Source="/Assets/StoreLogo.png"
                       Width="16"
                       Height="16" />

                <TextBlock Text="Athan"
                           Margin="8 0 0 0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="1"
                            PlaceholderText="Search for a city, region, or country"
                            QueryIcon="Find"
                            VerticalAlignment="Center">

                <AutoSuggestBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F"
                                         Invoked="SearchInvoked"
                                         Modifiers="Control" />
                </AutoSuggestBox.KeyboardAccelerators>
            </AutoSuggestBox>
        </Grid>

        <NavigationView x:Name="NavigationView"
                        Grid.Row="1"
                        SelectionChanged="NavigationViewSelectionChanged"
                        MenuItemsSource="{x:Bind viewModel.Items}"
                        AlwaysShowHeader="True"
                        IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        OpenPaneLength="225"
                        ExpandedModeThresholdWidth="700"
                        Margin="0 -2 0 0">

            <NavigationView.MenuItemTemplateSelector>
                <local:NavigationViewItemTemplateSelector>
                    <local:NavigationViewItemTemplateSelector.PrayersTemplate>
                        <DataTemplate x:DataType="local:PrayersViewModel">
                            <NavigationViewItem DataContext="{x:Bind}"
                                                Content="{x:Bind Title}">

                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="{x:Bind Emoji}"
                                              FontFamily="{x:Bind Family}" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </DataTemplate>
                    </local:NavigationViewItemTemplateSelector.PrayersTemplate>

                    <local:NavigationViewItemTemplateSelector.TasbihTemplate>
                        <DataTemplate x:DataType="local:TasbihViewModel">
                            <NavigationViewItem DataContext="{x:Bind}" Icon="Add" Content="Tasbih counting" />
                        </DataTemplate>
                    </local:NavigationViewItemTemplateSelector.TasbihTemplate>

                    <local:NavigationViewItemTemplateSelector.SeparatorTemplate>
                        <DataTemplate>
                            <NavigationViewItemSeparator />
                        </DataTemplate>
                    </local:NavigationViewItemTemplateSelector.SeparatorTemplate>
                </local:NavigationViewItemTemplateSelector>
            </NavigationView.MenuItemTemplateSelector>

            <ScrollViewer>
                <Frame x:Name="Frame"
                       Loaded="FrameLoaded"
                       Navigated="FrameNavigated" />
            </ScrollViewer>
        </NavigationView>
    </Grid>
</ex:WindowEx>