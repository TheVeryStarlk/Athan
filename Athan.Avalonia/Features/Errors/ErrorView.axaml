<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:errors="clr-namespace:Athan.Avalonia.Features.Errors"

             x:Class="Athan.Avalonia.Features.Errors.ErrorView"
             x:DataType="errors:ErrorViewModel">

    <StackPanel>
        <TextBlock Text="A fatal error has occured. Please restart Athan." />
        <TextBlock Text="{CompiledBinding Message}" />
        <Button Content="Close" Command="{CompiledBinding CloseCommand}" />
    </StackPanel>
</UserControl>