<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:retry="clr-namespace:Athan.Avalonia.Features.Prayers.Retry"

             x:Class="Athan.Avalonia.Features.Prayers.Retry.RetryView"
             x:DataType="retry:RetryViewModel">

    <StackPanel Margin="10" Spacing="10" Width="250">
        <StackPanel Spacing="5">
            <TextBlock Text="Opsie!" FontWeight="Bold" />
            <TextBlock Text="{CompiledBinding Message}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Close" Command="{CompiledBinding CloseCommand}" />
            <Button Content="Retry" Command="{CompiledBinding RetryCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>