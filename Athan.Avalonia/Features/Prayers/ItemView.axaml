<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prayers="clr-namespace:Athan.Avalonia.Features.Prayers"

             x:Class="Athan.Avalonia.Features.Prayers.ItemView"
             x:DataType="prayers:Prayer"

             PointerEntered="ItemOnPointerEntered" PointerExited="ItemOnPointerExited">

    <Grid Background="Transparent">
        <Grid Margin="15">
            <Grid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.5" />
                        </Transitions>
                    </Setter>
                </Style>
            </Grid.Styles>

            <StackPanel Orientation="Horizontal" Spacing="15">
                <TextBlock Text="{CompiledBinding Emoji}" />
                <TextBlock Text="{CompiledBinding Name}" FontWeight="Bold" />
            </StackPanel>

            <TextBlock x:Name="TimeText" Text="{CompiledBinding Time}" HorizontalAlignment="Right" />
            <TextBlock x:Name="MessageText" Text="{CompiledBinding Message}" HorizontalAlignment="Right" Opacity="0" />
        </Grid>
    </Grid>
</UserControl>