<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Athan.Avalonia.Features.Shell"

        x:Class="Athan.Avalonia.Features.Shell.ShellView"
        x:DataType="shell:ShellViewModel"

        Icon="/Assets/Athan.ico" Title="Athan" Content="{CompiledBinding Current}">
</Window>