<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Athan.Avalonia.ViewModels"

             x:Class="Athan.Avalonia.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">

    <StackPanel>
        <TextBlock Text="You're one click away!" />
        <Button Content="Click" Command="{CompiledBinding StartCommand}" />
    </StackPanel>
</UserControl>