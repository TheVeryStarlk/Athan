<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athan.Avalonia.ViewModels"

             x:Class="Athan.Avalonia.Views.PrayerView"
             x:DataType="vm:PrayerViewModel">

    <StackPanel>
        <Button Content="Initialize" Command="{CompiledBinding InitializeCommand}" />
        <TextBlock Text="{CompiledBinding Result}" />
    </StackPanel>
</UserControl>